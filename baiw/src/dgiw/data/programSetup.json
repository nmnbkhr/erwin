{
  "flows": [
    {
      "id": "F1",
      "name": "Mobilisation & Mandate",
      "objective": "Establish that the programme has an authority base before any technical work begins. Everything downstream depends on this flow completing properly — a programme that skips it will stall at the first cross-domain dispute.",
      "steps": [
        {
          "id": "F1-S1",
          "stream": "Mandate",
          "step": "Confirm the executive sponsor and verify budget authority",
          "owner": "Engagement Lead",
          "inputs": [
            "Organisation chart",
            "Delegated authority schedule"
          ],
          "outputs": [
            "Sponsor confirmation with authority test evidenced"
          ],
          "durationDays": 2,
          "layer": "core"
        },
        {
          "id": "F1-S2",
          "stream": "Mandate",
          "step": "Draft and socialise the Data Governance charter",
          "owner": "Engagement Lead",
          "inputs": [
            "Charter template",
            "Sponsor objectives",
            "Existing policy set"
          ],
          "outputs": [
            "Draft DG charter"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F1-S3",
          "stream": "Mandate",
          "step": "Place the DG Council within the existing committee hierarchy",
          "owner": "Engagement Lead",
          "inputs": [
            "Committee terms of reference",
            "Governance calendar"
          ],
          "outputs": [
            "Council placement note and reporting line"
          ],
          "durationDays": 2,
          "layer": "banking"
        },
        {
          "id": "F1-S4",
          "stream": "Mandate",
          "step": "Obtain charter signature and constitute the council",
          "owner": "Executive Sponsor",
          "inputs": [
            "Final charter",
            "Proposed membership"
          ],
          "outputs": [
            "Signed charter",
            "Council terms of reference",
            "Meeting calendar"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F1-S5",
          "stream": "Scope",
          "step": "Agree the first domain and the boundary of what is out of scope",
          "owner": "Engagement Lead",
          "inputs": [
            "Diagnostic roadmap",
            "Sponsor priorities"
          ],
          "outputs": [
            "Scope statement with explicit exclusions"
          ],
          "durationDays": 2,
          "layer": "core"
        }
      ],
      "gateIds": [
        "G1",
        "G2",
        "G6"
      ]
    },
    {
      "id": "F2",
      "name": "Accountability Installation",
      "objective": "Convert the charter into named people with real time. This is the flow most programmes execute badly, and the failure is invisible for about two months.",
      "steps": [
        {
          "id": "F2-S1",
          "stream": "Roles",
          "step": "Identify and confirm Data Owners at department-head level",
          "owner": "Executive Sponsor",
          "inputs": [
            "Domain scope",
            "Role definitions"
          ],
          "outputs": [
            "Named Data Owners with written acceptance"
          ],
          "durationDays": 5,
          "layer": "core"
        },
        {
          "id": "F2-S2",
          "stream": "Roles",
          "step": "Owners nominate stewards; agree the time percentage with line managers",
          "owner": "Data Owner",
          "inputs": [
            "Steward role definition",
            "Workload assessment"
          ],
          "outputs": [
            "Named stewards with countersigned time allocation"
          ],
          "durationDays": 5,
          "layer": "core"
        },
        {
          "id": "F2-S3",
          "stream": "Roles",
          "step": "Identify custodians for each in-scope system",
          "owner": "Head of Technology",
          "inputs": [
            "System inventory",
            "Support model"
          ],
          "outputs": [
            "Custodian assignment per system"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F2-S4",
          "stream": "Roles",
          "step": "Confirm regulatory reporting, risk and compliance representatives for CDE derivation",
          "owner": "Engagement Lead",
          "inputs": [
            "Submission calendar",
            "Risk and compliance structure"
          ],
          "outputs": [
            "Named specialist contributors with time committed"
          ],
          "durationDays": 2,
          "layer": "banking"
        },
        {
          "id": "F2-S5",
          "stream": "Enablement",
          "step": "Run steward onboarding and tooling induction",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Training pack",
            "Platform access"
          ],
          "outputs": [
            "Trained stewards with platform access confirmed"
          ],
          "durationDays": 3,
          "layer": "core"
        }
      ],
      "gateIds": [
        "G3",
        "G4"
      ]
    },
    {
      "id": "F3",
      "name": "Scope Derivation — Critical Data Elements",
      "objective": "Produce the finite, defensible element list that bounds every subsequent activity. Derived backwards from consumption, never nominated forwards from systems.",
      "steps": [
        {
          "id": "F3-S1",
          "stream": "Derivation",
          "step": "Select the consumption points that define criticality",
          "owner": "Engagement Lead",
          "inputs": [
            "Board KPI pack",
            "Report inventory"
          ],
          "outputs": [
            "Prioritised consumption point list"
          ],
          "durationDays": 2,
          "layer": "core"
        },
        {
          "id": "F3-S2",
          "stream": "Derivation",
          "step": "Select the priority regulatory returns and disclosures driving scope",
          "owner": "Head of Regulatory Reporting",
          "inputs": [
            "Submission calendar",
            "Examination findings history"
          ],
          "outputs": [
            "Priority return list with line items identified"
          ],
          "durationDays": 3,
          "layer": "banking"
        },
        {
          "id": "F3-S3",
          "stream": "Derivation",
          "step": "Trace lineage backwards from each consumption point to source fields",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Report logic",
            "ETL documentation",
            "Lineage templates"
          ],
          "outputs": [
            "Backward lineage traces per consumption point"
          ],
          "durationDays": 10,
          "layer": "core",
          "support": [
            "Data Custodian"
          ]
        },
        {
          "id": "F3-S4",
          "stream": "Derivation",
          "step": "Consolidate traced elements into the CDE register and de-duplicate",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Lineage traces",
            "Reference CDE catalogue"
          ],
          "outputs": [
            "Draft CDE register with source system and criticality"
          ],
          "durationDays": 4,
          "layer": "core"
        },
        {
          "id": "F3-S5",
          "stream": "Derivation",
          "step": "Assign an owner and steward to every element; escalate unassignable ones",
          "owner": "DG Council",
          "inputs": [
            "Draft register",
            "Role assignments"
          ],
          "outputs": [
            "Owned CDE register",
            "Open-risk log for unassigned elements"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F3-S6",
          "stream": "Derivation",
          "step": "Ratify the register at council and freeze the baseline",
          "owner": "DG Council",
          "inputs": [
            "Owned register"
          ],
          "outputs": [
            "Ratified CDE baseline with change control applied"
          ],
          "durationDays": 1,
          "layer": "core"
        }
      ],
      "gateIds": [
        "G5"
      ]
    },
    {
      "id": "F4",
      "name": "Standards, Policy & Enforcement Design",
      "objective": "Produce a policy set where every policy names its enforcement point. Policies with no enforcement point are not adopted — they are the artefact of failed programmes.",
      "steps": [
        {
          "id": "F4-S1",
          "stream": "Policy",
          "step": "Tailor the policy and standards set from the artefact library",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Policy templates",
            "Existing bank policy set"
          ],
          "outputs": [
            "Draft policy and standards set"
          ],
          "durationDays": 5,
          "layer": "core"
        },
        {
          "id": "F4-S2",
          "stream": "Policy",
          "step": "Define the data classification scheme and labelling standard",
          "owner": "Chief Information Security Officer",
          "inputs": [
            "Existing information security classification",
            "Regulatory constraints"
          ],
          "outputs": [
            "Classification scheme approved for use"
          ],
          "durationDays": 3,
          "layer": "core",
          "support": [
            "DG Office / Data Governance Lead"
          ]
        },
        {
          "id": "F4-S3",
          "stream": "Enforcement",
          "step": "Identify at least one enforcement point per policy",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Draft policies",
            "Pipeline and gate inventory"
          ],
          "outputs": [
            "Policy-to-enforcement-point mapping"
          ],
          "durationDays": 3,
          "layer": "core",
          "support": [
            "Data Custodian"
          ]
        },
        {
          "id": "F4-S4",
          "stream": "Enforcement",
          "step": "Define the issue management workflow with severity, SLA and escalation",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Workflow template",
            "Existing incident process"
          ],
          "outputs": [
            "Issue workflow definition with SLA schedule"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F4-S5",
          "stream": "Policy",
          "step": "Approve the policy set and exception process at council",
          "owner": "DG Council",
          "inputs": [
            "Policy set",
            "Enforcement mapping"
          ],
          "outputs": [
            "Approved policy set",
            "Exception register opened"
          ],
          "durationDays": 1,
          "layer": "core"
        }
      ],
      "gateIds": [
        "G7"
      ]
    },
    {
      "id": "F5",
      "name": "Platform Standup",
      "objective": "Get catalogue, quality engine, lineage collection and scorecard running against real systems. Deferred until after the operating model and CDE register exist, deliberately.",
      "steps": [
        {
          "id": "F5-S1",
          "stream": "Platform",
          "step": "Confirm the tooling decision and complete procurement or deployment approval",
          "owner": "Head of Technology",
          "inputs": [
            "Blueprint tooling recommendation",
            "Estate constraints"
          ],
          "outputs": [
            "Approved tooling decision"
          ],
          "durationDays": 5,
          "layer": "core"
        },
        {
          "id": "F5-S2",
          "stream": "Platform",
          "step": "Deploy catalogue, quality engine and lineage collector",
          "owner": "Data Engineering",
          "inputs": [
            "Deployment scripts",
            "Environment and network approval"
          ],
          "outputs": [
            "Running platform in the target environment"
          ],
          "durationDays": 5,
          "layer": "core"
        },
        {
          "id": "F5-S3",
          "stream": "Platform",
          "step": "Configure connectors and prove metadata extraction from the vendor core",
          "owner": "Data Engineering",
          "inputs": [
            "Core banking access",
            "Vendor metadata documentation"
          ],
          "outputs": [
            "Proven extraction with scheduled harvest"
          ],
          "durationDays": 8,
          "layer": "banking"
        },
        {
          "id": "F5-S4",
          "stream": "Platform",
          "step": "Schedule automated harvesting and configure failure alerting",
          "owner": "Data Engineering",
          "inputs": [
            "Connector configuration",
            "Monitoring stack"
          ],
          "outputs": [
            "Scheduled harvest with alerting to a named owner"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F5-S5",
          "stream": "Platform",
          "step": "Stand up the scorecard layer over the quality result store",
          "owner": "Data Engineering",
          "inputs": [
            "DQ result store",
            "Scorecard template"
          ],
          "outputs": [
            "Scorecard published to stakeholders"
          ],
          "durationDays": 4,
          "layer": "core"
        }
      ],
      "gateIds": [
        "G11"
      ]
    },
    {
      "id": "F6",
      "name": "Quality Instrumentation",
      "objective": "Bind executable rules to the governed elements and get a real number in front of the business. This flow produces the artefact that funds the rest of the programme.",
      "steps": [
        {
          "id": "F6-S1",
          "stream": "Quality",
          "step": "Profile the source systems to establish a defect baseline",
          "owner": "Data Engineering",
          "inputs": [
            "Source access",
            "CDE register"
          ],
          "outputs": [
            "Profiling baseline per source"
          ],
          "durationDays": 5,
          "layer": "core"
        },
        {
          "id": "F6-S2",
          "stream": "Quality",
          "step": "Select and tailor rules from the library for the governed CDEs",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Rule library",
            "CDE register",
            "Profiling results"
          ],
          "outputs": [
            "Tailored rule set with thresholds agreed by owners"
          ],
          "durationDays": 6,
          "layer": "banking",
          "support": [
            "Data Steward"
          ]
        },
        {
          "id": "F6-S3",
          "stream": "Quality",
          "step": "Deploy rules to the engine and schedule execution",
          "owner": "Data Engineering",
          "inputs": [
            "Rule definitions",
            "Quality engine"
          ],
          "outputs": [
            "Rules executing on schedule with results stored"
          ],
          "durationDays": 4,
          "layer": "core"
        },
        {
          "id": "F6-S4",
          "stream": "Quality",
          "step": "Publish the first scorecard and walk owners through their results",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Rule results",
            "Scorecard layer"
          ],
          "outputs": [
            "Published scorecard with owner acknowledgement"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F6-S5",
          "stream": "Quality",
          "step": "Open the issue queue and triage the first tranche of defects",
          "owner": "Data Steward",
          "inputs": [
            "Scorecard failures",
            "Issue workflow"
          ],
          "outputs": [
            "Triaged issue queue with owners and target dates"
          ],
          "durationDays": 5,
          "layer": "core"
        }
      ],
      "gateIds": [
        "G8"
      ]
    },
    {
      "id": "F7",
      "name": "Run & Expand",
      "objective": "Move from delivery to operation — prove the client can run a full cycle unaided, then onboard the next domain.",
      "steps": [
        {
          "id": "F7-S1",
          "stream": "Run",
          "step": "Run a full monthly cycle with the delivery team observing only",
          "owner": "Data Steward",
          "inputs": [
            "Scorecard",
            "Issue queue",
            "Council calendar"
          ],
          "outputs": [
            "Completed cycle with decisions recorded"
          ],
          "durationDays": 20,
          "layer": "core",
          "support": [
            "DG Office / Data Governance Lead"
          ]
        },
        {
          "id": "F7-S2",
          "stream": "Run",
          "step": "Measure benefit movement against the pre-programme baseline",
          "owner": "DG Office / Data Governance Lead",
          "inputs": [
            "Benefit baseline",
            "Current metrics"
          ],
          "outputs": [
            "Benefit realisation report"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F7-S3",
          "stream": "Expand",
          "step": "Select and scope the next domain using the same derivation method",
          "owner": "DG Council",
          "inputs": [
            "Roadmap",
            "Capacity assessment"
          ],
          "outputs": [
            "Next domain scope statement"
          ],
          "durationDays": 3,
          "layer": "core"
        },
        {
          "id": "F7-S4",
          "stream": "Expand",
          "step": "Assess regulatory change impact on the governed element set",
          "owner": "Head of Regulatory Reporting",
          "inputs": [
            "Regulatory change log",
            "CDE register"
          ],
          "outputs": [
            "Change impact assessment with register updates"
          ],
          "durationDays": 3,
          "layer": "banking"
        }
      ],
      "gateIds": [
        "G9",
        "G10"
      ]
    }
  ],
  "checklist": [
    {
      "id": "CL-01",
      "phase": "Mobilisation",
      "item": "Executive sponsor named and budget authority verified, not assumed",
      "artefact": "Sponsor confirmation note",
      "owner": "Engagement Lead",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-02",
      "phase": "Mobilisation",
      "item": "DG charter signed by the sponsor",
      "artefact": "Signed DG charter",
      "owner": "Executive Sponsor",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-03",
      "phase": "Mobilisation",
      "item": "Council constituted with terms of reference, membership and quorum rules",
      "artefact": "Council terms of reference",
      "owner": "DG Office / Data Governance Lead",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-04",
      "phase": "Mobilisation",
