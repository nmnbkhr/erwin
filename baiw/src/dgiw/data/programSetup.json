      "artefact": "Scope statement",
      "owner": "Engagement Lead",
      "blocking": true,
      "pillarId": "P02",
      "layer": "core"
    },
    {
      "id": "CL-06",
      "phase": "Mobilisation",
      "item": "Benefit baseline measured before any delivery work starts",
      "artefact": "Benefit baseline record",
      "owner": "DG Office / Data Governance Lead",
      "blocking": true,
      "pillarId": "P02",
      "layer": "core"
    },
    {
      "id": "CL-07",
      "phase": "Mobilisation",
      "item": "Cost of poor data quantified in the client's own figures",
      "artefact": "Cost-of-poor-data model",
      "owner": "Engagement Lead",
      "blocking": false,
      "pillarId": "P02",
      "layer": "core"
    },
    {
      "id": "CL-08",
      "phase": "Mobilisation",
      "item": "Regulatory submission calendar mapped to data dependencies",
      "artefact": "Submission dependency map",
      "owner": "Head of Regulatory Reporting",
      "blocking": false,
      "pillarId": "P02",
      "layer": "banking"
    },
    {
      "id": "CL-09",
      "phase": "Accountability",
      "item": "Data Owner named for every in-scope domain at department-head level",
      "artefact": "Ownership register",
      "owner": "Executive Sponsor",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-10",
      "phase": "Accountability",
      "item": "Owners have accepted accountability in writing",
      "artefact": "Accountability acceptances",
      "owner": "Data Owner",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-11",
      "phase": "Accountability",
      "item": "Stewards named with a written time percentage in their objectives, countersigned by line managers",
      "artefact": "Steward allocation letters",
      "owner": "Data Owner",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-12",
      "phase": "Accountability",
      "item": "Custodian identified for every in-scope system",
      "artefact": "Custodian assignment register",
      "owner": "Head of Technology",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-13",
      "phase": "Accountability",
      "item": "RACI published and walked through with all named parties",
      "artefact": "RACI matrix",
      "owner": "DG Office / Data Governance Lead",
      "blocking": false,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-14",
      "phase": "Accountability",
      "item": "Regulatory reporting, risk and compliance contributors committed to CDE derivation",
      "artefact": "Contributor commitment note",
      "owner": "Engagement Lead",
      "blocking": true,
      "pillarId": "P01",
      "layer": "banking"
    },
    {
      "id": "CL-15",
      "phase": "Accountability",
      "item": "Escalation path documented and tested with a live item",
      "artefact": "Escalation procedure",
      "owner": "DG Office / Data Governance Lead",
      "blocking": false,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-16",
      "phase": "Scope Derivation",
      "item": "Consumption points selected and agreed before any element nomination",
      "artefact": "Consumption point list",
      "owner": "Engagement Lead",
      "blocking": true,
      "pillarId": "P07",
      "layer": "core"
    },
    {
      "id": "CL-17",
      "phase": "Scope Derivation",
      "item": "Priority regulatory returns identified with the line items that drive scope",
      "artefact": "Priority return list",
      "owner": "Head of Regulatory Reporting",
      "blocking": true,
      "pillarId": "P07",
      "layer": "banking"
    },
    {
      "id": "CL-18",
      "phase": "Scope Derivation",
      "item": "Backward lineage completed from each consumption point to source fields",
      "artefact": "Backward lineage traces",
      "owner": "DG Office / Data Governance Lead",
      "blocking": true,
      "pillarId": "P07",
      "layer": "core"
    },
    {
      "id": "CL-19",
      "phase": "Scope Derivation",
      "item": "CDE register consolidated, de-duplicated and criticality-rated",
      "artefact": "CDE register",
      "owner": "DG Office / Data Governance Lead",
      "blocking": true,
      "pillarId": "P03",
      "layer": "core"
    },
    {
      "id": "CL-20",
      "phase": "Scope Derivation",
      "item": "Every CDE has a named owner and steward; unassigned elements logged as open risks",
      "artefact": "Owned CDE register + open risk log",
      "owner": "DG Council",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-21",
      "phase": "Scope Derivation",
      "item": "System of record designated per entity by its Data Owner",
      "artefact": "System-of-record designation gap register",
      "owner": "Data Owner",
      "blocking": true,
      "pillarId": "P03",
      "layer": "core"
    },
    {
      "id": "CL-22",
      "phase": "Scope Derivation",
      "item": "CDE register ratified at council and placed under change control",
      "artefact": "Ratified CDE baseline",
      "owner": "DG Council",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-23",
      "phase": "Scope Derivation",
      "item": "Core banking structures mapped to the banking reference model",
      "artefact": "Reference model mapping",
      "owner": "Data Architect",
      "blocking": false,
      "pillarId": "P03",
      "layer": "banking"
    },
    {
      "id": "CL-24",
      "phase": "Standards & Policy",
      "item": "Policy and standards set drafted and approved at council",
      "artefact": "Approved policy set",
      "owner": "DG Office / Data Governance Lead",
      "blocking": true,
      "pillarId": "P01",
      "layer": "core"
    },
    {
      "id": "CL-25",
      "phase": "Standards & Policy",
      "item": "Every policy names at least one enforcement point",
      "artefact": "Policy-to-enforcement mapping",
      "owner": "DG Office / Data Governance Lead",
      "blocking": true,
      "pillarId": "P10",
      "layer": "core"
    },
    {
      "id": "CL-26",
      "phase": "Standards & Policy",
      "item": "Data classification scheme approved and labelling standard defined",
      "artefact": "Classification scheme",
      "owner": "Chief Information Security Officer",
      "blocking": true,
      "pillarId": "P08",
      "layer": "core"
    },
