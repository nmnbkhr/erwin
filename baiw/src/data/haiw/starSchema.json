        {
          "name": "icd10_chapter",
          "type": "VARCHAR(100)",
          "description": "ICD-10 chapter"
        },
        {
          "name": "disease_category",
          "type": "VARCHAR(50)",
          "description": "Communicable, NCD, injury, etc."
        },
        {
          "name": "is_notifiable",
