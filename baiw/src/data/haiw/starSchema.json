    },
    {
      "name": "DIM_PAYER",
      "description": "Insurance and payer dimension",
      "columns": [
        {
          "name": "payer_key",
          "type": "INTEGER",
          "description": "Surrogate key"
        },
        {
          "name": "payer_name",
          "type": "VARCHAR(100)",
