        },
        {
          "name": "plan_name",
          "type": "VARCHAR(100)",
          "description": "Insurance plan name"
        },
        {
          "name": "coverage_type",
          "type": "VARCHAR(30)",
          "description": "Inpatient, outpatient, both"
        }
      ]
    },
    {
      "name": "DIM_MEDICATION",
      "description": "Medication and drug dimension",
      "columns": [
        {
          "name": "medication_key",
          "type": "INTEGER",
          "description": "Surrogate key"
        },
        {
          "name": "drug_code",
          "type": "VARCHAR(20)",
          "description": "Drug code"
        },
        {
          "name": "drug_name",
          "type": "VARCHAR(200)",
          "description": "Drug generic name"
        },
        {
          "name": "brand_name",
          "type": "VARCHAR(200)",
          "description": "Brand name"
        },
        {
          "name": "therapeutic_class",
          "type": "VARCHAR(50)",
